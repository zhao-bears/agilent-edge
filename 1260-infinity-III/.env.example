NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=1260-infinity-iii

# Directory that contains "OpenLab Acquisition" and "OpenLab Services".
# moses.set_config searches it for Agilent.OpenLab.RawData.dll,
# Agilent.OpenLab.Storage.dll, and Agilent.OpenLab.SharedServices.dll.
AGILENT_SDK_DIR=C:\Path\To\OpenLab\SDK

# Directory that contains Agilent.OpenLAB.Acquisition.AutomationCore.dll
AGILENT_AUTOMATION_CORE=C:\Path\To\OpenLab\AutomationCore

# Directory that contains Agilent.OpenLAB.Acquisition.AutomationInstrument.dll
AGILENT_AUTOMATION_INSTRUMENT=C:\Path\To\OpenLab\AutomationInstrument

# Moses instrument JSON. Copy instrument.example.json and fill in the OpenLab
# connection string, project, and template method paths.
INSTRUMENT_CONFIG_PATH=C:\CDSProjects\1260-infinity-iii.json

# G7112B binary pump settable maximum is 5 mL/min.
# A quaternary pump may use a higher value from its own manual.
MAX_FLOW_ML_MIN=5.0
# Standard 1260 vialsampler or multisampler metering head.
MAX_INJECTION_UL=100
MAX_RUN_TIME_MIN=120
