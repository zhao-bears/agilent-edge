NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=1260-infinity-iii

# Parent of "OpenLab Acquisition" and "OpenLab Services" on this workstation.
# Moses loads these files relative to this directory:
#   OpenLab Acquisition\Agilent.OpenLab.RawData.dll
#   OpenLab Services\Common\Agilent.OpenLab.SharedServices.dll
#   OpenLab Services\Server\Agilent.OpenLab.Storage.dll
AGILENT_SDK_DIR=C:\Program Files (x86)\Agilent Technologies

# Directory that directly contains the OpenLab automation core assembly.
# On this workstation it is under C:\Windows\Microsoft.NET\assembly\GAC_32.
# Moses loads this file from this directory:
#   Agilent.OpenLAB.Acquisition.AutomationCore.dll
AGILENT_AUTOMATION_CORE=C:\Windows\Microsoft.NET\assembly\GAC_32\Agilent.OpenLAB.Acquisition.AutomationCore\v4.0_2.8.0.0__968ccb09b2a5fe74

# Directory that directly contains the OpenLab automation instrument assembly.
# On this workstation it is under C:\Windows\Microsoft.NET\assembly\GAC_32.
# Moses loads this file from this directory:
#   Agilent.OpenLAB.Acquisition.AutomationInstrument.dll
AGILENT_AUTOMATION_INSTRUMENT=C:\Windows\Microsoft.NET\assembly\GAC_32\Agilent.OpenLAB.Acquisition.AutomationInstrument\v4.0_2.8.0.0__968ccb09b2a5fe74

# config.json in this directory. Fill in the connection string
# and the .amx, .smx, and .pmx paths.
INSTRUMENT_CONFIG_PATH=config.json

# G7112B binary pump settable maximum is 5 mL/min.
# A quaternary pump may use a higher value from its own manual.
MAX_FLOW_ML_MIN=5.0
# Standard 1260 vialsampler or multisampler metering head.
MAX_INJECTION_UL=100
MAX_RUN_TIME_MIN=120
